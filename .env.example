# Copy to .env and fill in. All keys are free-tier.

# LLM providers (tried in the order configured in config.yaml)
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (fallback)

# Vector DB: Qdrant server started with `docker compose up -d qdrant`.
# Leave empty to use embedded Qdrant instead (data/qdrant; single process,
# fine for small experiments).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Any config.yaml value can be overridden, e.g.:
# RAG_RETRIEVAL__TOP_K=8
# RAG_APP__LOG_LEVEL=DEBUG
